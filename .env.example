# Required for public SEO URLs in sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Optional: enables a consent-gated Google Analytics tag after you provide your GA4 Measurement ID
NEXT_PUBLIC_GA_ID=
# Keep the Gemini API key server-only
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash
